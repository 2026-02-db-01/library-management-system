# 호스트 nginx: /etc/nginx/sites-available/library (sites-enabled 에 심볼릭 링크)
# 인증서는 다른 서비스와 같은 Cloudflare 원본 인증서(*.misakachan.moe)
# http2 는 끔: CVE-2026-123007/123633 (2026-11-18 공개) 패치 전 완화책. Cloudflare→원본은 HTTP/1.1 이라 영향 없음
server {
    listen 80;
    listen [::]:80;
    server_name library.misakachan.moe;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name library.misakachan.moe;
    ssl_certificate     /etc/ssl/cloudflare/localroute-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/localroute-origin.key;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
