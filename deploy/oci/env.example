# /srv/stacks/library/.env (chmod 600). 실제 값은 서버에만 둔다.
# N100 DB 는 터널로 127.0.0.1:5433. N100 pg_hba 가 hostssl 만 받으므로 sslmode=require.
DATABASE_URL=postgresql+psycopg://library_app:CHANGE_ME@127.0.0.1:5433/library?sslmode=require
SECRET_KEY=CHANGE_ME_64_random_chars
DEBUG=false
CORS_ORIGINS=["https://library.misakachan.moe"]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
