# DB 는 database/ 폴더의 컨테이너를 쓴다 (database/README.md 참고).
# 백엔드는 library_app 계정으로 접속한다. 비밀번호는 database/.env 의 LIBRARY_APP_PASSWORD 와 같은 값.
LIBRARY_APP_PASSWORD=your_library_app_password

# 로컬에서 uvicorn 으로 실행할 때의 DB 연결 URL (동기 드라이버 psycopg3 사용)
# (docker compose --profile full 로 띄우면 docker-compose.yml 이 db:5432 로 바꿔 넣는다)
DATABASE_URL=postgresql+psycopg://library_app:your_library_app_password@127.0.0.1:5433/library

# 애플리케이션 환경
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT 인증 설정 (실제 운영 시 32자 이상 무작위 문자열 사용)
SECRET_KEY=replace-this-with-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 프론트엔드 (Vite 빌드 시점에 주입)
# 비워 두면 /api/... 상대 경로를 사용한다. 기본값이며 운영 배포도 이 값을 쓴다.
#   - 로컬 개발: Vite 개발 프록시가 http://127.0.0.1:8000(FastAPI)으로 전달
#   - 운영(OCI, https://library.misakachan.moe): 같은 도메인의 nginx 가 /api 를
#     FastAPI 로 넘긴다 (deploy/oci/README.md). 같은 출처라 CORS·SameSite 설정 불필요.
# 프론트와 백엔드가 다른 출처일 때만 FastAPI 외부 URL 을 넣는다
# (예: npm run test:e2e:live 가 자동으로 지정). 이 경우 CORS_ORIGINS·쿠키 SameSite 조정 필요.
VITE_API_BASE_URL=
# GitHub Pages 정적 미리보기 빌드에서만 true (HashRouter + /library-management-system/ base).
# Pages 에는 백엔드가 없어 화면 구경용이며, deploy-pages.yml 이 빌드 환경변수로 주입한다.
VITE_GITHUB_PAGES=false
