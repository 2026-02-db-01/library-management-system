# PostgreSQL 설정
POSTGRES_USER=library_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=library_db
POSTGRES_PORT=5432

# 로컬 백엔드 실행용 DB 연결 URL (동기 드라이버 psycopg3 사용)
DATABASE_URL=postgresql+psycopg://library_user:your_postgres_password@localhost:5432/library_db

# 애플리케이션 환경
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT 인증 설정 (실제 운영 시 32자 이상 무작위 문자열 사용)
SECRET_KEY=replace-this-with-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
